Z_MANIFEST_CONSTANT(MAGIC, 0x4c41455a)
Z_MANIFEST_CONSTANT(VERSION, 2)
Z_MANIFEST_CONSTANT(ABI, 4)
Z_MANIFEST_CONSTANT(CELL_MAX, 4)
Z_MANIFEST_CONSTANT(GRANT_MAX, 16)
Z_MANIFEST_CONSTANT(IMAGE_COUNT_MAX, 8)
Z_MANIFEST_CONSTANT(TEMPLATE_MAX, 8)
Z_MANIFEST_CONSTANT(DOMAIN_MAX, 8)
Z_MANIFEST_CONSTANT(ROOT_POOL_PAGES, 80)
Z_MANIFEST_CONSTANT(DYNAMIC_SLOTS, 4)
Z_MANIFEST_CONSTANT(DYNAMIC_PAGES, 48)
Z_MANIFEST_CONSTANT(DEPTH_MAX, 2)
Z_MANIFEST_CONSTANT(BOOTSTRAP_RPC, 1)
Z_MANIFEST_CONSTANT(BOOTSTRAP_SNAPSHOT, 2)
Z_MANIFEST_CONSTANT(ARTIFACT_MAX, 1320)
Z_MANIFEST_CONSTANT(PAGE_SIZE, 4096)
Z_MANIFEST_CONSTANT(IMAGE_MAX, 65536)
Z_MANIFEST_CONSTANT(STACK_MIN, 4096)
Z_MANIFEST_CONSTANT(STACK_MAX, 16384)
Z_MANIFEST_CONSTANT(HEAP_MAX, 65536)
Z_MANIFEST_CONSTANT(WRITABLE_MAX, 81920)
Z_MANIFEST_CONSTANT(POOL_PAGES, 128)
Z_MANIFEST_CONSTANT(PAGES_PER_CELL, 20)
Z_MANIFEST_CONSTANT(CONFIG_MAX, 27)
Z_MANIFEST_CONSTANT(RESTART_LIMIT, 3)
Z_MANIFEST_CONSTANT(RESTART_DELAY, 4)
Z_MANIFEST_CONSTANT(RIGHTS, 0x800fffff)
Z_MANIFEST_CONSTANT(ACTIVE, 1)
Z_MANIFEST_CONSTANT(CONSOLE, 4)

Z_MANIFEST_BEGIN(header)
Z_MANIFEST_U32(magic)
Z_MANIFEST_U32(version)
Z_MANIFEST_U32(total_size)
Z_MANIFEST_U32(cell_count)
Z_MANIFEST_U32(grant_count)
Z_MANIFEST_U32(template_count)
Z_MANIFEST_U32(domain_count)
Z_MANIFEST_U32(reserved0)
Z_MANIFEST_U32(reserved1)
Z_MANIFEST_U32(reserved2)
Z_MANIFEST_END(header, 40)

Z_MANIFEST_BEGIN(cell)
Z_MANIFEST_U32(identity)
Z_MANIFEST_U32(image)
Z_MANIFEST_U32(abi)
Z_MANIFEST_U32(flags)
Z_MANIFEST_U64(entry)
Z_MANIFEST_U32(image_budget)
Z_MANIFEST_U32(stack_budget)
Z_MANIFEST_U32(writable_budget)
Z_MANIFEST_U32(boot_config)
Z_MANIFEST_U32(restart_limit)
Z_MANIFEST_U32(restart_delay)
Z_MANIFEST_BYTES(name, 16)
Z_MANIFEST_END(cell, 64)

Z_MANIFEST_BEGIN(grant)
Z_MANIFEST_U32(holder)
Z_MANIFEST_U32(target)
Z_MANIFEST_U32(rights)
Z_MANIFEST_U32(flags)
Z_MANIFEST_END(grant, 16)

Z_MANIFEST_BEGIN(template)
Z_MANIFEST_U32(identity)
Z_MANIFEST_U32(image)
Z_MANIFEST_U32(abi)
Z_MANIFEST_U32(flags)
Z_MANIFEST_U64(entry)
Z_MANIFEST_U32(image_budget)
Z_MANIFEST_U32(stack_budget)
Z_MANIFEST_U32(writable_budget)
Z_MANIFEST_U32(boot_config)
Z_MANIFEST_U32(restart_limit)
Z_MANIFEST_U32(restart_delay)
Z_MANIFEST_U32(max_descendant_depth)
Z_MANIFEST_U32(child_template_mask)
Z_MANIFEST_U32(bootstrap_recipe)
Z_MANIFEST_U32(reserved)
Z_MANIFEST_END(template, 64)

Z_MANIFEST_BEGIN(domain)
Z_MANIFEST_U32(owner_identity)
Z_MANIFEST_U32(template_mask)
Z_MANIFEST_U32(slot_limit)
Z_MANIFEST_U32(page_limit)
Z_MANIFEST_U32(max_depth)
Z_MANIFEST_U32(bootstrap_recipe)
Z_MANIFEST_U32(reserved0)
Z_MANIFEST_U32(reserved1)
Z_MANIFEST_END(domain, 32)
